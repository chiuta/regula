{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "region", "players", "board", "pieces", "setup", "moves", "win", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "names": { "type": "object" },
    "region": { "type": "string", "minLength": 1 },
    "players": { "type": "integer", "minimum": 1, "maximum": 8 },
    "status": { "type": "string", "enum": ["established", "reconstructed", "simplified", "unverified"] },
    "board": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer" },
        "w": { "type": "integer", "minimum": 1, "maximum": 26 },
        "h": { "type": "integer", "minimum": 1, "maximum": 26 },
        "diagonals": { "type": "string", "enum": ["none", "all", "alternate"] },
        "render": { "type": "string", "enum": ["lines", "cells"] },
        "points": { "type": "object" },
        "lines": { "type": "array", "items": { "type": "array", "minItems": 2 } },
        "edges": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } },
        "sets": { "type": "object" },
        "forward": { "type": "object" }
      }
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "side": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "glyph": { "type": "string" }
        }
      }
    },
    "setup": { "type": "string", "minLength": 1 },
    "moves": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "win": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "notes": {},
    "rules": {
      "type": "object",
      "properties": {
        "sides": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "first": { "type": "string" },
        "mandatoryCapture": { "type": "boolean" },
        "hand": { "type": "object" },
        "setup": { "type": "object" },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["drop", "step", "slide", "fly", "jump", "approach-withdraw", "mill", "custodial", "king-capture"] },
              "piece": { "type": "string" },
              "dirs": {},
              "from": { "type": "string" },
              "fromNot": { "type": "string" },
              "to": { "type": "string" },
              "toNot": { "type": "string" },
              "requires": { "type": "string", "enum": ["adjacent-enemy"] },
              "when": { "type": "object" },
              "chain": { "type": "string", "enum": ["none", "optional", "forced"] },
              "max": { "type": "integer", "minimum": 1 },
              "len": { "type": "integer", "minimum": 3 },
              "protect": { "type": "string", "enum": ["mill", "none"] },
              "noRevisit": { "type": "boolean" },
              "noSameDir": { "type": "boolean" },
              "edgeSafe": { "type": "boolean" },
              "throne": { "type": "string" },
              "hostile": { "type": "array", "items": { "type": "object", "required": ["set"] } }
            }
          }
        },
        "restricted": { "type": "array", "items": { "type": "object", "required": ["set"] } },
        "win": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["reach", "eliminate", "lose-when-none", "blocked", "line", "draw"] },
              "piece": { "type": "string" },
              "set": { "type": "string" },
              "side": { "type": "string" },
              "below": { "type": "integer", "minimum": 1 },
              "len": { "type": "integer", "minimum": 2 },
              "result": { "type": "string", "enum": ["loss", "draw"] },
              "repeat": { "type": "integer", "minimum": 2 },
              "noCaptureTurns": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
